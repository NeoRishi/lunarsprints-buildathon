{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scheduling response",
  "description": "Generated from src/features/lunarsprints/agents/contract.ts by npm run contracts:build. Do not edit. $defs holds the answer the model must give for each task.",
  "type": "object",
  "properties": {
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/schedule_notes"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model",
        "input_tokens",
        "output_tokens",
        "latency_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "result",
    "usage"
  ],
  "additionalProperties": false,
  "$defs": {
    "schedule_notes": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "2.1"
        },
        "agentId": {
          "type": "string",
          "const": "scheduling"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "needs_clarification",
            "blocked",
            "error"
          ]
        },
        "payload": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "notes": {
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "notes"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clarification": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "options": {
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "question",
                "options"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "blocker"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "severity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "agentId",
        "status",
        "payload",
        "missingFields",
        "clarification",
        "warnings"
      ],
      "additionalProperties": false
    }
  }
}
