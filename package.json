{
  "name": "lunarsprints",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/database.test.ts",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests db package.json tsconfig.json next.config.ts vitest.config.ts vitest.integration.config.ts eslint.config.mjs",
    "test:auth": "firebase emulators:exec --only auth --project lunarsprints-62d7d \"vitest run --config vitest.integration.config.ts tests/auth-emulator.test.ts\"",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --test",
    "emulators": "firebase emulators:start --only auth --project lunarsprints-62d7d",
    "dev:local": "firebase emulators:exec --only auth --ui --project lunarsprints-62d7d \"npm run dev\"",
    "test:rls": "vitest run --config vitest.integration.config.ts tests/rls.test.ts"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "lucide-react": "1.62.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "15.37.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
