{
  "name": "lunarsprints",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/database.test.ts",
    "lint": "eslint .",
    "test:e2e": "tsx --env-file=.env.local scripts/end-to-end.ts",
    "format": "prettier --write src scripts tests package.json tsconfig.json next.config.ts vitest.config.ts eslint.config.mjs",
    "test:multi": "tsx --env-file=.env.local scripts/multi-goal.ts",
    "test:execution": "tsx --env-file=.env.local scripts/execution-check.ts",
    "test:replan": "tsx --env-file=.env.local scripts/replan-check.ts",
    "test:auth": "tsx --env-file=.env.local scripts/auth-regression.ts",
    "test:platform": "tsx --env-file=.env.local scripts/lifeos-integration.ts",
    "test:recovery": "tsx --env-file=.env.local scripts/clarification-recovery-check.ts",
    "test:performance": "tsx --env-file=.env.local scripts/planning-performance-check.ts",
    "test:scheduling": "tsx --env-file=.env.local scripts/scheduling-acceptance.ts"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
